    "preview": "node scripts/dev-server.mjs"
  },
  "devDependencies": {
    "@shikijs/transformers": "^4.4.3",
    "esbuild": "^0.28.2",
    "markdown-it": "^15.0.0",
    "mermaid": "^11.16.1",
    "shiki": "^4.4.3",
    "typescript": "^5.8.3",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "markdown-it-container": "^4.0.0"
  }
}
