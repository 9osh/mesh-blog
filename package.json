{
  "name": "mesh",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/bundle-client.mjs && cp src/styles/main.css dist/styles.css && node scripts/build-site.mjs",
